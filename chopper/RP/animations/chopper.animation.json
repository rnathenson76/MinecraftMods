{
  "format_version": "1.8.0",
  "animations": {
    "animation.chopper.rotor": {
      "loop": true,
      "animation_length": 0.15,
      "bones": {
        "main_rotor": {
          "rotation": { "0.0": [0, 0, 0], "0.15": [0, 360, 0] }
        },
        "tail_rotor": {
          "rotation": { "0.0": [0, 0, 0], "0.15": [360, 0, 0] }
        }
      }
    },
    "animation.chopper.door_open": {
      "loop": true,
      "bones": {
        "door_left": { "rotation": [0, -105, 0] },
        "door_right": { "rotation": [0, 105, 0] }
      }
    },
    "animation.chopper.door_closed": {
      "loop": true,
      "bones": {
        "door_left": { "rotation": [0, 0, 0] },
        "door_right": { "rotation": [0, 0, 0] }
      }
    }
  }
}
