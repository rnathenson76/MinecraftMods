{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.chopper.door": {
      "initial_state": "open",
      "states": {
        "open": {
          "animations": ["door_open"],
          "blend_transition": 0.35,
          "transitions": [
            { "closed": "!q.property('vehicles:doors_open')" }
          ]
        },
        "closed": {
          "animations": ["door_closed"],
          "blend_transition": 0.35,
          "transitions": [
            { "open": "q.property('vehicles:doors_open')" }
          ]
        }
      }
    },
    "controller.animation.chopper.visibility": {
      "initial_state": "visible",
      "states": {
        "visible": {
          "transitions": [
            { "hidden": "!q.property('vehicles:doors_open')" }
          ]
        },
        "hidden": {
          "animations": ["chopper_hidden"],
          "transitions": [
            { "visible": "q.property('vehicles:doors_open')" }
          ]
        }
      }
    }
  }
}
